{
  // Trang đặt tour cho khách: SPA phục vụ file tĩnh, cộng một API POST /api/booking-request (worker/index.ts)
  // kiểm tra Cloudflare Turnstile rồi gọi database bằng khóa service.
  // Build với VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY / VITE_TURNSTILE_SITEKEY trước khi chạy wrangler deploy.
  // Bí mật đặt bằng `wrangler secret put`: TURNSTILE_SECRET, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY (không ghi vào file này).
  "name": "saha-tour-store",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Lưu log Worker (lý do Turnstile từ chối, lỗi gọi database) để xem lại trong trang Cloudflare.
  "observability": { "enabled": true },
  // Giữ địa chỉ saha-tour-store.<account>.workers.dev kể cả khi gắn thêm tên miền riêng.
  "workers_dev": true,
  // Tên miền riêng (zone trong tài khoản Cloudflare, nameserver bingo/brodie.ns.cloudflare.com).
  "routes": [
    { "pattern": "hanoiadventuretours.com", "custom_domain": true },
    { "pattern": "www.hanoiadventuretours.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API, trang có thẻ SEO, robots.txt, sitemap.xml đi qua Worker; file tĩnh (js, css, ảnh) trả trực tiếp.
    "run_worker_first": ["/api/*", "/", "/tours", "/tours/", "/tour/*", "/robots.txt", "/sitemap.xml"]
  },
  "vars": {
    "SUPABASE_URL": "https://api-tourhub.217-216-39-53.sslip.io",
    "STOREFRONT_ORG": "hanoi-jeep",
    // Tên miền trang khách được chấp nhận trong kết quả siteverify (không gồm localhost).
    "TURNSTILE_HOSTNAMES": "hanoiadventuretours.com,www.hanoiadventuretours.com,saha-tour-store.chungnd-dsc.workers.dev"
  }
}
