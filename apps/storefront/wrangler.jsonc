{
  // Trang đặt tour cho khách: SPA thuần, Worker chỉ phục vụ file tĩnh (giống apps/admin).
  // Build với VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY của môi trường cần deploy trước khi chạy wrangler deploy.
  "name": "saha-tour-store",
  "compatibility_date": "2026-10-01",
  // Giữ địa chỉ saha-tour-store.<account>.workers.dev kể cả khi gắn thêm tên miền riêng.
  "workers_dev": true,
  // Tên miền riêng (zone trong tài khoản Cloudflare, nameserver bingo/brodie.ns.cloudflare.com).
  "routes": [
    { "pattern": "hanoiadventuretours.com", "custom_domain": true },
    { "pattern": "www.hanoiadventuretours.com", "custom_domain": true }
  ],
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
}
