{
  "name": "saha-tour-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:admin": "pnpm --filter @tours/admin dev",
    "dev:worker": "pnpm --filter @tours/worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:db": "pnpm --filter @tours/database test",
    "dev:stack": "node scripts/dev-stack.mjs",
    "db:start": "supabase start -x studio,imgproxy,storage-api,realtime,edge-runtime,logflare,vector,mailpit,postgres-meta,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "node --env-file=.env scripts/seed-demo.mjs",
    "db:test-server": "node scripts/dev-postgres.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "^8.13.0",
    "prettier": "^3.4.0",
    "supabase": "^2.40.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
