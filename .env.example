# Sao chép thành .env ở thư mục gốc. Không đưa file .env vào Git.
#
# Lấy giá trị local bằng lệnh: pnpm exec supabase status

# Worker kết nối thẳng database. Production: dùng role riêng chỉ có quyền EXECUTE các hàm worker_*.
WORKER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
WORKER_POLL_MS=5000
WORKER_HEALTH_PORT=3102

# Chỉ các script quản trị và seed dùng. KHÔNG đưa khóa này ra trình duyệt.
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# Mật khẩu cho tài khoản demo local. Bỏ trống thì seed tự sinh ngẫu nhiên và ghi vào .demo-accounts.local.
DEMO_PASSWORD=

# Test: Postgres dùng để dựng database tạm.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# Kết nối kênh thật: chưa dùng. Tên các bí mật này được khai ở channel_connections.credential_ref;
# giá trị nằm trong secret manager, không bao giờ trong database. Xem docs/CHANNEL_INTEGRATION.md.
# VIATOR_API_KEY_ACCOUNT_1=
# GETYOURGUIDE_BASIC_AUTH_ACCOUNT_1=
